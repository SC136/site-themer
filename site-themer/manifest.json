{
  "manifest_version": 3,
  "name": "Site Themer",
  "version": "1.2.0",
  "description": "Custom themes for your favorite sites. Currently: WhatsApp Web and YouTube (AMOLED black and more).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Site Themer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["sites/whatsapp.css"],
      "js": ["shared/registry.js", "shared/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["sites/youtube.css"],
      "js": ["shared/registry.js", "shared/content.js"],
      "run_at": "document_start"
    }
  ]
}
